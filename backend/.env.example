DATABASE_URL=postgresql://fraudex_user:fraudex_dev_password@localhost:5432/fraudex_db
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Fraud Detection Configuration
FRAUD_AMOUNT_SIMILARITY_THRESHOLD=0.05
FRAUD_DATE_WINDOW_DAYS=7
FRAUD_ANOMALY_STD_DEV_MULTIPLIER=3.0
FRAUD_HIGH_REJECTION_RATE_THRESHOLD=0.30
FRAUD_MIN_VENDOR_HISTORY=5
ADMIN_SIGNUP_KEY=your-secret-admin-key-here

# AI analysis: local Ollama (default) or Gemini if a key is set
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5-coder:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Policy search embeddings: "auto" uses Ollama when it is running and a local
# embedding otherwise; "local" never calls Ollama.
RAG_EMBEDDER=auto
# GEMINI_API_KEY=
