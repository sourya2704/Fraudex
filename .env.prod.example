# Copy to .env.prod and change every password/secret before deploying.
POSTGRES_PASSWORD=change-me-db-password
# Long random string, e.g. from: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-long-random-secret
ADMIN_SIGNUP_KEY=change-me-admin-signup-key

# First admin, created on first start if missing
ADMIN_EMAIL=admin@fraudex.io
ADMIN_PASSWORD=change-me-admin-password

# true: fill an empty database with ~1000 demo invoices on first start
SEED_DEMO_DATA=true

# Port on the host
APP_PORT=8080

# Optional: Google AI Studio key for AI-written explanations
GEMINI_API_KEY=
